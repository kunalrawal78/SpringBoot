BT 1 0 0 1 8 43.3 Tm /F4 7.7 Tf 10.2 TL (public Student createStudent\(Student student\) { log.info\("Method started"\);) Tj T* (securityService.checkPermission\("CREATE_STUDENT"\); long start = System.currentTimeMillis\(\); try {) Tj T* (Student result = studentRepository.save\(student\); auditService.record\("STUDENT_CREATED"\); return) Tj T* (result; } catch \(Exception exception\) { log.error\("Method failed", exception\); throw exception; }) Tj T* (finally { metrics.record\(System.currentTimeMillis\(\) - start\); } }) Tj T* ET
